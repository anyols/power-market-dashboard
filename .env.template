# Copy this file to .env and fill in your token.
# ENTSO-E Transparency Platform API token. Leave empty to run on the synthetic sample data.
ENTSOE_API_TOKEN=

# EIA API key (free): https://www.eia.gov/opendata/register.php - crude prices and weekly balances.
EIA_API_KEY=

# Power data source: auto (refreshed store > live API if token > sample) | store | entsoe | sample
DATA_SOURCE=auto

# Local SQLite cache of raw API responses (data/raw/entsoe_cache.sqlite). Set to 0 to disable.
ENTSOE_CACHE=1
